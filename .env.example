# Copy this file to .env.local for local development. On Vercel, set the same names under
# Project → Settings → Environment Variables.

# Required. Get a key at https://console.anthropic.com/ (server-side only, never sent to the browser).
ANTHROPIC_API_KEY=

# Optional. If set, visitors must enter this code once before any AI feature works (handy for a private beta).
APP_ACCESS_CODE=

# Optional. Maximum AI requests per day across all visitors, per server instance (default 1000).
AI_DAILY_LIMIT=

# Optional. Contact address shown on the /privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=
